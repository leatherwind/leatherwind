# -----------------------------------------------------------------------------
# Leather Wind — environment configuration
# -----------------------------------------------------------------------------
# Everything below is OPTIONAL. The site works with none of it set; public
# business details live in src/config/site.ts, which is the recommended place
# to edit them (they are needed at build time for metadata and the sitemap).
#
# These variables exist only so that a deployment platform can override values
# without a code change.
# -----------------------------------------------------------------------------

# Public production domain, used for canonical URLs, Open Graph and the sitemap.
# Example: https://www.leatherwind.com
NEXT_PUBLIC_SITE_URL=

# Business WhatsApp number in international format, digits only, no "+" and no
# spaces or punctuation. Example for a UK number: 447700900123
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional public contact details. Leave blank to hide the corresponding block.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
